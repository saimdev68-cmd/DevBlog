SECRET_KEY=your-production-secret-key-at-least-50-characters-long
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,your-domain.com,.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://*.onrender.com
SECURE_SSL_REDIRECT=False

# Production Database (Neon PostgreSQL or similar)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Initial Superuser Creation (Used by 'python manage.py create_admin' on deployment)
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=your-secure-admin-password
DJANGO_SUPERUSER_FIRST_NAME=Admin
DJANGO_SUPERUSER_LAST_NAME=User

# Email Configuration (SMTP for password reset & notices)
# EMAIL_BACKEND=apps.core.email_backend.ConsoleAndSmtpEmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=DevBlog <noreply@example.com>

# Celery & Redis Task Queue
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=False

# Google OAuth 2.0
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:8000/accounts/google/login/callback/
